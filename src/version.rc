#include <winver.h>

// Truthful version metadata (BDFFHD's reasoning): a file named hid.dll with no version
// resource looks like a system-library impersonation. This says plainly what the file is.
// Nothing here claims to be Microsoft's.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION    0,9,2,0
 PRODUCTVERSION 0,9,2,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "FFPR Screen Reader Project (bladestorm360)"
            VALUE "FileDescription",  "FINAL FANTASY I-VI Pixel Remaster Screen Reader (accessibility mod for blind players)"
            VALUE "FileVersion",      "0.9.2.0"
            VALUE "InternalName",     "ffpr_screen_reader"
            VALUE "OriginalFilename", "hid.dll"
            VALUE "ProductName",      "Final Fantasy Pixel Master Core Screen Reader"
            VALUE "ProductVersion",   "0.9.2.0"
            VALUE "Comments",         "Speaks menus, dialogue, battle and field information through Prism. Loads as a hid.dll proxy and forwards every export of the system hid.dll unchanged."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
